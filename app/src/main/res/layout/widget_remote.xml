<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp"
    android:background="@drawable/widget_bg">

    <TextView android:id="@+id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="6dp" android:paddingEnd="6dp"
        android:text="Control by VORDER" android:textColor="#FFFFFFFF"
        android:textSize="13sp" android:textStyle="bold" android:singleLine="true"/>

    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/b1" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:padding="9dp"
                android:background="@drawable/widget_btn_accent" android:scaleType="fitCenter" android:src="@drawable/ic_w_power"
                android:contentDescription="@null"/>
            <ImageView android:id="@+id/b2" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:padding="9dp"
                android:background="@drawable/widget_btn" android:scaleType="fitCenter" android:src="@drawable/ic_w_power"
                android:contentDescription="@null"/>
            <ImageView android:id="@+id/b3" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:padding="9dp"
                android:background="@drawable/widget_btn" android:scaleType="fitCenter" android:src="@drawable/ic_w_power"
                android:contentDescription="@null"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/b4" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:padding="9dp"
                android:background="@drawable/widget_btn" android:scaleType="fitCenter" android:src="@drawable/ic_w_power"
                android:contentDescription="@null"/>
            <ImageView android:id="@+id/b5" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:padding="9dp"
                android:background="@drawable/widget_btn" android:scaleType="fitCenter" android:src="@drawable/ic_w_power"
                android:contentDescription="@null"/>
            <ImageView android:id="@+id/b6" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:padding="9dp"
                android:background="@drawable/widget_btn" android:scaleType="fitCenter" android:src="@drawable/ic_w_power"
                android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>
